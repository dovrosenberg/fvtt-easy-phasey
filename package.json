{
  "name": "fvtt-easy-phasey",
  "version": "1.2.0",
  "private": true,
  "description": "Foundry VTT v14 module to manage phased maps.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dovrosenberg/fvtt-easy-phasey.git"
  },
  "author": "Dov Rosenberg",
  "homepage": "https://github.com/dovrosenberg/fvtt-easy-phasey#readme",
  "main": "main.ts",
  "scripts": {
    "build": "vite build",
    "debug": "vite build --minify=false --mode development",
    "lint": "eslint --ext .ts,.vue src",
    "linkdata": "ln -s $PWD/dist ~/foundry14data/Data/modules/easy-phasey",
    "tsc": "vue-tsc --skipLibCheck -p ./tsconfig.json",
    "unlinkdata": "unlink ~/foundry14data/Data/modules/easy-phasey",
    "foundry": "node ~/foundry14/resources/app/main.js --dataPath=/home/dov/foundry14data"
  },
  "devDependencies": {
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@types/jquery": "^3.5.32",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#main",
    "prettier": "^3.4.2",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-scss": "^4.0.1",
    "sass": "^1.83.0",
    "semver-increment": "^1.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.6",
    "vite-plugin-env-compatible": "^2.0.1",
    "vite-plugin-html": "3.2.2",
    "vue-tsc": "^3.3.14"
  }
}
